    {
        "id": "b9bf24fa84b1f5a4",
        "type": "function",
        "z": "8ada3cb510c5cdd7",
        "name": "Interpretar ",
        "func": "// 1. Limpiar espacios y saltos de línea de la trama recibida\nlet trama = msg.payload.toString().trim();\n\n// 2. Verificar si es una trama \"(OK)\"\nif (trama === \"(OK)\") {\n    msg.payload = \"OK\";\n    return msg;\n}\n\n// 3. Verificar si empieza con \"(FLIP)\"\nif (trama.startsWith(\"(FLIP)\")) {\n    // Extraer todos los valores que estén entre corchetes [...] usando expresiones regulares\n    let coincidencias = [...trama.matchAll(/\\[([^\\]]+)\\]/g)];\n    \n    // Obtener solo el contenido interno de cada corchete en un array: [\"num1\", \"num2\", ...]\n    let numerosFlipeados = coincidencias.map(m => m[1].trim());\n    \n    if (numerosFlipeados.length > 0) {\n        // Formatear para el archivo CSV/TXT: ej. \"FLIP, 12, 45, 108\"\n        msg.payload = \"FLIP, \" + numerosFlipeados.join(\", \");\n    } else {\n        msg.payload = \"FLIP, SIN_DATOS\";\n    }\n    \n    return msg;\n}\n\n// Si llega ruido o una trama vacía/no reconocida, descartarla\nreturn null;\n\n\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
