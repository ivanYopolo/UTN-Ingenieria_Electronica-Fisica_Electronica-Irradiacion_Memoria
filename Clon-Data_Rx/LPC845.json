        "id": "407ae230a4f65382",
        "type": "function",
        "z": "7d7a16224e695315",
        "name": "send now",
        "func": "\nlet current_file = flow.get(\"current_file\")\n\nif (current_file != null)\n{\n    const CONFIG = global.get(\"GlobalConfig\")\n    const proyecto = env.get(\"proyecto\");\n    const subdir = env.get(\"subdir\");\n\n    const dir = `${proyecto}/${subdir}`\n\n    flow.set(\"count_dps\", 0);\n    flow.set(\"current_file\", null)\n    msg.tempfile = `${CONFIG.tempDirectory}/${dir}/${current_file}`\n    msg.sendfile = `${CONFIG.sendDirectory}/${dir}/${current_file}`\n    return msg;\n}",
