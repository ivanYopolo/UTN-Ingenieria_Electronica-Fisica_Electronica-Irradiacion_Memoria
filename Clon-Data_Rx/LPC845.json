    {
        "id": "a4a5c5035a7996f5",
        "type": "function",
        "z": "7d7a16224e695315",
        "name": "format for file",
        "func": "let date__ = new Date()\nlet count_dps = flow.get(\"count_dps\") ?? 0 // cuenta de datapoints\nconst CONFIG = global.get(\"GlobalConfig\")\nconst proyecto = env.get(\"proyecto\");\nconst subdir = env.get(\"subdir\");\nconst max_dps_per_file = env.get(\"max_dps\");\n\nconst dir = `${proyecto}/${subdir}`\n\ncount_dps ++;\n\nlet current_file\n\nif (flow.get(\"current_file\") == null)\n{\n    current_file = `${date__.getFullYear()}-${date__.getMonth()+1}-${date__.getDate()}_${date__.getHours()}-${date__.getMinutes()}-${date__.getSeconds()}.txt`\n    flow.set(\"current_file\", current_file)\n}\nelse\n{\n    current_file = flow.get(\"current_file\")\n}\nmsg.tempfile = `${CONFIG.tempDirectory}/${dir}/${current_file}`\n\nmsg.payload = `${date__.getFullYear()}-${date__.getMonth()+1}-${date__.getDate()} ${date__.getHours()}:${date__.getMinutes()}:${date__.getSeconds()}.${date__.getMilliseconds()}, ${msg.payload}\\n`\n\nmsg.is_lastest = count_dps >= max_dps_per_file;\n\nif (msg.is_lastest)\n{\n    count_dps = 0;\n    flow.set(\"current_file\", null)\n    msg.sendfile = `${CONFIG.sendDirectory}/${dir}/${current_file}`\n}\n\n\nflow.set(\"count_dps\", count_dps)\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
